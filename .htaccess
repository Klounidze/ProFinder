# Включаем Passenger
PassengerEnabled On

# Путь к приложению
PassengerAppRoot /home/u3590216/вpfinder.site

# Путь к интерпретатору Python
PassengerPython /home/u3590216/pfinder.site/venv/bin/python

# Перенаправление на Passenger
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ /passenger_wsgi.py/$1 [QSA,L]